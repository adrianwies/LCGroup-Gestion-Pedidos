# Copia este archivo como .env solo para desarrollo local.
# En Vercel configura estas variables en Project Settings > Environment Variables.
# Variables usadas por docker compose local:
DEMO_DB_PASSWORD=REEMPLAZAR_CON_CLAVE_SQL_LOCAL

# Variables usadas directamente por la API en Vercel:
ConnectionStrings__SqlServer=Server=dbXXXX.public.databaseasp.net;Database=dbXXXX;User Id=dbXXXX;Password=REEMPLAZAR;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15;MultipleActiveResultSets=True
Database__CreateIfMissing=false
ASPNETCORE_ENVIRONMENT=Production

# Web Push: genera un par distinto por ambiente y guarda la privada solo en el hosting.
WebPush__VapidSubject=mailto:administrador@tu-dominio.com
WebPush__VapidPublicKey=REEMPLAZAR_CLAVE_PUBLICA_VAPID
WebPush__VapidPrivateKey=REEMPLAZAR_CLAVE_PRIVADA_VAPID

