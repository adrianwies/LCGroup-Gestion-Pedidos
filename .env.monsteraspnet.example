# Configurar estos valores únicamente en las variables del hosting.
# No guardar una copia con credenciales reales en Git.
ConnectionStrings__SqlServer=Server=SERVIDOR_MONSTER;Database=BASE_MONSTER;User Id=USUARIO_MONSTER;Password=REEMPLAZAR_EN_HOSTING;Encrypt=True;TrustServerCertificate=False;Connect Timeout=15;MultipleActiveResultSets=True
Database__CreateIfMissing=false

# Mantener las claves VAPID privadas solo en variables del hosting.
WebPush__VapidSubject=mailto:correo-autorizado@dominio.com
WebPush__VapidPublicKey=REEMPLAZAR_EN_HOSTING
WebPush__VapidPrivateKey=REEMPLAZAR_EN_HOSTING
